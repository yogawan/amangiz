# MongoDB Atlas connection string
MONGODB_URI="YOUR_MONGODB_URI_HERE"

# Session signing key for the HS256 JWT in the session cookie.
# Must be at least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=""

# Cloudinary — evidence and document storage.
# The API secret is server-only and must never be exposed to the browser.
CLOUDINARY_CLOUD_NAME="YOUR_CLOUDINARY_CLOUD_NAME_HERE"
CLOUDINARY_API_KEY="YOUR_CLOUDINARY_API_KEY_HERE"
CLOUDINARY_API_SECRET="YOUR_CLOUDINARY_API_SECRET_HERE"

# When true, /login shows a Demo Accounts modal with seeded credentials
# (for judges/reviewers to try every role). Leave unset or "false" in prod.
IS_SANDBOX=false
